# Preset: both pools have budget.
# Model IDs are "<provider-id>/<model-id>". On the work laptop, list them with:  opencode models
# Replace every TODO before running install.sh — it refuses to run while a TODO is left.
#
# This split is a starting guess: explorer makes the most calls, so it goes on Copilot;
# the main agent and deep-thinker stay on Portkey. Change it after you see a week of spend.

ROUTER_MODEL="TODO-portkey-provider-id/TODO-sonnet-5.5-model-id"
FAST_MODEL="TODO-copilot-provider-id/TODO-haiku-5.5-model-id"
HEAVY_MODEL="TODO-portkey-provider-id/TODO-opus-5.5-model-id"

# Max model steps per subagent run. On the last step opencode removes tools and asks for a summary.
EXPLORER_STEPS=15
HEAVY_STEPS=20
